{
  "name": "buriburiland-tetris-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "regression": "vitest run tests/regression",
    "benchmark": "node scripts/run-tool.mjs benchmark",
    "replay": "node scripts/run-tool.mjs replay",
    "test:browser": "node scripts/browser-check.mjs",
    "test:garbage": "node scripts/garbage-browser-check.mjs",
    "test:gauges": "node scripts/gauge-browser-check.mjs",
    "verify:source": "node scripts/source-contract.mjs",
    "start": "node scripts/serve.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.2",
    "vitest": "5.0.5"
  }
}
